# OpsRoom v4 (spike/v4 branch) — all optional; the demo runs deterministic without keys.

# Real LLM inference (verified: OpenAI gpt-5.4-mini)
OPENAI_API_KEY=
# LLM_MODEL=<mozaik registry name, e.g. gpt-5.4-mini>
# OPENAI_BASE_URL=https://api.openai.com/v1

# Mozaik Cloud observability (session streams in the Mozaik console)
# MOZAIK_API_KEY=pk_...

# Web console port (default 8788)
# OPSROOM_PORT=8788
